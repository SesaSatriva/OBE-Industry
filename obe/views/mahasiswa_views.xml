<odoo>
  <data>
    <record id="view_mahasiswa_tree" model="ir.ui.view">
      <field name="name">obe.mahasiswa.list</field>
      <field name="model">obe.mahasiswa</field>
      <field name="arch" type="xml">
        <tree>
          <header>
            <button name="%(action_import_mahasiswa_wizard)d"
              string="Import via Excel"
              type="action"
              class="btn-primary" />
          </header>
          <field name="nim" />
          <field name="name" />
          <field name="kelas" />
          <field name="angkatan" />
        </tree>
      </field>
    </record>


    <record id="view_mahasiswa_form" model="ir.ui.view">
      <field name="name">obe.mahasiswa.form</field>
      <field name="model">obe.mahasiswa</field>
      <field name="arch" type="xml">
        <form>
          <sheet>

            <group>
              <field name="nim" />
              <field name="name" />
              <field name="email" />
            </group>

            <group>
              <field name="kelas" />
              <field name="angkatan" />
              <field name="rombel" />
            </group>

            <group string="Akun Portal" col="2">
              <!-- Relasi utama -->
              <field name="user_id"
                options="{'no_create': True}"
                help="Akun portal yang terhubung dengan mahasiswa" />

              <!-- Input password (tidak disimpan) -->
              <field name="password"
                password="True"
                placeholder="Isi untuk set / reset password"
                help="Password hanya dipakai saat disimpan, tidak disimpan di database" />
            </group>

            <notebook>
              <page string="Mata Kuliah">
                <field name="mata_kuliah_ids" />
              </page>
              <page string="Nilai">
                <field name="nilai_ids" />
              </page>
            </notebook>

          </sheet>
        </form>
      </field>
    </record>


    <!-- wizard -->
    <record id="view_import_mahasiswa_wizard" model="ir.ui.view">
      <field name="name">import.mahasiswa.wizard.form</field>
      <field name="model">import.mahasiswa.wizard</field>
      <field name="arch" type="xml">
        <form string="Import Mahasiswa">
          <group>
            <field name="file_name" invisible="1" />
            <field name="file_data" filename="file_name" />
          </group>
          <footer>
            <button name="action_import"
              string="Import Data"
              type="object"
              class="btn-primary" />
            <button string="Cancel"
              special="cancel"
              class="btn-secondary" />
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>